{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(tools/godot.sh *)",
      "Bash(python .claude/hooks/*)",
      "mcp__godot-ai__editor_state",
      "mcp__godot-ai__logs_read",
      "mcp__godot-ai__scene_get_hierarchy",
      "mcp__godot-ai__node_find",
      "mcp__godot-ai__node_get_properties",
      "mcp__godot-ai__script_manage",
      "mcp__godot-ai__editor_screenshot",
      "mcp__godot-ai__api_manage"
    ],
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 15,
            "statusMessage": "Loading project status"
          }
        ]
      }
    ]
  }
}
