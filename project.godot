; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dungeons of Praesidium"
config/description="Turn-based tactical dungeon-crawler RPG (v1)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Settings="*res://scripts/settings.gd"
Party="*res://scripts/party.gd"
GameState="*res://scripts/game_state.gd"
Skins="*res://scripts/skins.gd"
SafeArea="*res://scripts/safe_area.gd"
Fade="*res://scripts/scene_fade.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
DevTools="*res://scripts/dev/dev_tools.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://i18n/translations.pt_BR.translation", "res://i18n/translations.en.translation")
locale/fallback="pt_BR"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
