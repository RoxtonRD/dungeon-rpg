; Project-wide UI theme. Wired via project.godot gui/theme/custom.
;
; Palette intent: a warm dungeon-cozy look — dark scrim panels with a subtle
; gold border, cream text, gold accents on hover / pressed buttons. Individual
; nodes can still override styles with add_theme_*_override for special cases
; (e.g. combat BattlerPanel keeps its own panel stylebox).
[gd_resource type="Theme" load_steps=8 format=3]

[sub_resource type="StyleBoxFlat" id="panel_default"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
bg_color = Color(0.1, 0.08, 0.14, 0.85)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.55, 0.42, 0.22, 0.5)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

